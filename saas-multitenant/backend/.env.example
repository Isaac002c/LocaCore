# ============================================================
# CR Multas CRM — Backend Environment Variables
# Copie para .env e preencha com os valores reais.
# NUNCA commite o arquivo .env no git.
# ============================================================

# ---------------------------
# Banco de dados (Neon PostgreSQL)
# Formato: postgresql://user:password@host/database?sslmode=require
# ---------------------------
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# ---------------------------
# Porta do servidor
# Em Docker, manter 5000 (Nginx faz o proxy externamente)
# ---------------------------
PORT=5000

# ---------------------------
# JWT Secret — OBRIGATÓRIO trocar em produção
# Gerar com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ---------------------------
JWT_SECRET=TROQUE_ISSO_POR_UMA_CHAVE_SEGURA_DE_64_BYTES

# ---------------------------
# URL do frontend em produção (para CORS)
# Ex: https://crmultas.vercel.app
# ---------------------------
FRONTEND_URL=https://SEU-PROJETO.vercel.app

# ---------------------------
# Ambiente
# ---------------------------
NODE_ENV=production

# ---------------------------
# URL pública do backend (usada para montar URLs de uploads/anexos)
# Ex: https://api-despachante.SEU-DOMINIO.com.br
# ---------------------------
BASE_URL=https://api.SEU-DOMINIO.com.br

# ---------------------------
# SMTP — Envio de protocolo por e-mail (OPCIONAL)
# Se NÃO preenchido, o botão "Enviar protocolo por e-mail" retorna 503
# ("envio de e-mail não configurado") sem quebrar o sistema.
# Recomendado: provedor transacional (Brevo, Amazon SES, SMTP do domínio).
# SMTP_SECURE=true para porta 465 (SSL); false para 587 (STARTTLS).
# ---------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CR Recursos <no-reply@SEU-DOMINIO.com.br>"
