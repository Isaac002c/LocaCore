# Copie para deploy/.env.evolution no servidor e use segredos aleatórios.
# Nunca versionar o arquivo preenchido.
SERVER_NAME=locacore-evolution
SERVER_TYPE=http
SERVER_PORT=8080
SERVER_URL=http://locacore-evolution:8080
SERVER_DISABLE_DOCS=true
SERVER_DISABLE_MANAGER=false
# A API só é publicada em loopback e na rede Docker; liberar a origem é
# necessário para chamadas sem header Origin feitas pelo backend/healthcheck.
CORS_ORIGIN=*
CORS_METHODS=GET,POST,PUT,DELETE
CORS_CREDENTIALS=true

DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://locacore_evolution:CHANGE_ME@evolution-postgres:5432/locacore_evolution
DATABASE_CONNECTION_CLIENT_NAME=locacore
DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=false
# Não persista updates quando as mensagens-base não são persistidas; essa
# combinação gera MessageUpdate órfão no Prisma da Evolution.
DATABASE_SAVE_MESSAGE_UPDATE=false
DATABASE_SAVE_DATA_CONTACTS=false
DATABASE_SAVE_DATA_CHATS=false
DATABASE_SAVE_DATA_HISTORIC=false
DATABASE_SAVE_DATA_LABELS=false
DATABASE_SAVE_IS_ON_WHATSAPP=false
DATABASE_DELETE_MESSAGE=true

CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://evolution-redis:6379/0
CACHE_REDIS_PREFIX_KEY=locacore
CACHE_REDIS_TTL=604800
CACHE_REDIS_SAVE_INSTANCES=true
CACHE_LOCAL_ENABLED=false

AUTHENTICATION_API_KEY=CHANGE_ME
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false
LOG_LEVEL=ERROR,WARN,INFO
LOG_COLOR=false
LOG_BAILEYS=error
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=false
LANGUAGE=pt-BR
WEBHOOK_GLOBAL_ENABLED=false
WEBSOCKET_ENABLED=false
RABBITMQ_ENABLED=false
NATS_ENABLED=false
SQS_ENABLED=false
PUSHER_ENABLED=false
TYPEBOT_ENABLED=false
CHATWOOT_ENABLED=false
OPENAI_ENABLED=false
DIFY_ENABLED=false
N8N_ENABLED=false
EVOAI_ENABLED=false
FLOWISE_ENABLED=false
S3_ENABLED=false
PROMETHEUS_METRICS=false
TELEMETRY_ENABLED=false
CONFIG_SESSION_PHONE_CLIENT="Rental Log"
CONFIG_SESSION_PHONE_NAME=Chrome
QRCODE_LIMIT=30
QRCODE_COLOR="#6d28d9"

POSTGRES_USER=locacore_evolution
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=locacore_evolution
