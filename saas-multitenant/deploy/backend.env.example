# =============================================================================
# Backend .env — deploy NOVO (do zero). Copie para deploy/backend.env e preencha.
# NUNCA versione o arquivo real (deploy/backend.env está no .gitignore).
# =============================================================================

# Banco dentro do VPS (serviço "postgres" da mesma rede docker).
# sslmode=disable pois é rede interna do Docker (o config/db.js desliga SSL nesse caso).
# O usuário/senha/db devem casar com o docker-compose (POSTGRES_*).
DATABASE_URL=postgres://nexo:TROQUE_ESTA_SENHA@postgres:5432/nexo?sslmode=disable

# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=TROQUE_POR_UMA_CHAVE_DE_64_BYTES
# Gere outra chave, exclusiva, com 32 bytes em hexadecimal. Protege tokens por
# tenant e certificados A1 armazenados; nunca deve ser enviada ao frontend.
AUTOMATION_SECRETS_KEY=TROQUE_POR_64_CARACTERES_HEXADECIMAIS

PORT=5000
NODE_ENV=production

# Domínio do frontend na Vercel (para CORS). Ex.: https://nexos.vercel.app
FRONTEND_URL=https://SEU-PROJETO.vercel.app

# URL pública desta API (para montar links de uploads). Ex.: https://api.seu-dominio.com
BASE_URL=https://API-DOMINIO
SCHED_PAYMENT_RECONCILIATION_MS=300000

# Banco Inter / PIX Cobrança (fallback; preferir secrets cifrados por tenant na UI)
PAYMENT_INTER_CLIENT_ID=
PAYMENT_INTER_CLIENT_SECRET=
PAYMENT_INTER_PIX_KEY=
PAYMENT_INTER_PFX_BASE64=
PAYMENT_INTER_PFX_PASSWORD=
PAYMENT_INTER_CERTIFICATE=
PAYMENT_INTER_PRIVATE_KEY=
PAYMENT_INTER_ACCOUNT_NUMBER=

# SMTP (opcional — envio de protocolo por e-mail). Deixe vazio para desabilitar.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NEXO <no-reply@seu-dominio.com>"

# =============================================================================
# Variáveis do docker-compose (Postgres) — copie para deploy/.env
# =============================================================================
# POSTGRES_USER=nexo
# POSTGRES_PASSWORD=TROQUE_ESTA_SENHA        # deve casar com a DATABASE_URL acima
# POSTGRES_DB=nexo
# API_DOMAIN=api.seu-dominio.com
# CERTBOT_EMAIL=voce@seu-dominio.com
