# =============================================================================
# LocaCore — Exemplo de variáveis de PRODUÇÃO (.env.prod). NÃO comitar segredos.
# Copie para .env.prod e preencha. Secrets ficam AQUI/secret manager, nunca no banco.
#
# Arquitetura: BACKEND + POSTGRES na VPS · FRONTEND na VERCEL.
# Este arquivo é o env da VPS. As variáveis da Vercel são outras (ver runbook).
# =============================================================================

# ── Ambiente ──────────────────────────────────────────────────────────────────
NODE_ENV=production
NEXT_PUBLIC_APP_ENV=production        # development|test|homologacao|production (banner)

# ── Domínio da API + TLS (usados pelo nginx/certbot no compose) ───────────────
API_DOMAIN=api.seu-dominio.com.br     # domínio que aponta (DNS A) para o IP da VPS
CERTBOT_EMAIL=voce@seu-dominio.com.br # e-mail de aviso de expiração do Let's Encrypt
# Fase 1 (emitir certificado): templates-init | Fase 2 (HTTPS): templates
NGINX_TEMPLATES=templates-init

# ── Banco (VPS, rede interna do Docker — não exposto no host) ─────────────────
POSTGRES_USER=locacore
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=locacore
DATABASE_URL=postgres://locacore:troque-esta-senha@postgres:5432/locacore?sslmode=disable

# ── Auth / API ────────────────────────────────────────────────────────────────
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=troque-por-uma-chave-longa-aleatoria
PORT=5000
LOG_LEVEL=info

# URL pública do FRONTEND na Vercel — libera o CORS (sem '*').
FRONTEND_URL=https://locacore.vercel.app
# Origens extras liberadas no CORS (domínio custom), separadas por vírgula.
EXTRA_CORS_ORIGINS=

# URL pública DESTA API — usada para montar os links dos uploads.
# Sem isto, os arquivos enviados geram URL de localhost.
BASE_URL=https://api.seu-dominio.com.br

# ── Identidade do produto (parametrizável) ────────────────────────────────────
PRODUCT_NAME=LocaCore
PRODUCT_SIGNATURE=by TELUN
RECEIPT_PREFIX=LOCA

# ── Storage de arquivos ───────────────────────────────────────────────────────
# local = disco da VPS (volume `uploads` do compose; já persistente).
# s3    = S3-compatível (AWS/R2/MinIO). Sem credenciais completas o backend
#         RECUSA operar em s3 (não simula upload) e cai para local com aviso.
STORAGE_PROVIDER=local
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                          # defina para R2/MinIO; vazio para AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Worker / Scheduler (intervalos em ms) ─────────────────────────────────────
WORKER_INTERVAL_MS=60000
WORKER_BATCH=25
SCHED_OUTBOX_MS=300000                # 5 min
SCHED_OVERDUE_MS=3600000              # 1 h
SCHED_DUNNING_MS=21600000             # 6 h
SCHED_BILLING_MS=3600000              # 1 h
SCHED_FISCAL_MS=43200000              # 12 h

# ── Alertas / SMTP (opcional) ─────────────────────────────────────────────────
ALERT_EMAIL_TO=ops@seu-dominio.com.br
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LocaCore <no-reply@seu-dominio.com.br>"

# ── WhatsApp (Meta Cloud API) — só quando ativar o provider 'meta' ────────────
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
META_GRAPH_API_VERSION=v20.0

# ── Cobrança/PIX (Asaas) — só quando ativar o provider 'asaas' ────────────────
PAYMENT_ASAAS_KEY=
PAYMENT_ASAAS_WEBHOOK_TOKEN=
PAYMENT_ASAAS_BASE=https://api.asaas.com/v3

# ── Fiscal (Focus NFe) — só quando ativar + validação do contador ─────────────
FISCAL_FOCUSNFE_TOKEN=

# ── Backup ────────────────────────────────────────────────────────────────────
BACKUP_DIR=/backups
BACKUP_RETENTION_DAYS=14
